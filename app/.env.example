# All optional. The app runs keyless with NLSC orthophoto + OSM extruded buildings and the bundled FUNRAISE snapshot.
VITE_GOOGLE_MAPS_API_KEY=        # enables Google Photorealistic 3D Tiles (metered; replaces OSM extrusions)
VITE_CESIUM_ION_TOKEN=           # enables Cesium World Terrain (ion Community = non-commercial only)
VITE_API_BASE=                   # agent server origin when hosted elsewhere (e.g. https://peaklens-api.example.com); empty = same origin (/api)

# Agent server (server/index.mjs) — Claude mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
PORT=8790
PUBLIC_URL=                      # where the browser reaches this server (OAuth redirect); default http://localhost:8787

# FUNRAISE MCP ("Funraise Data Team" connector). OAuth 2.1 + PKCE + dynamic client registration is automatic:
# when the MCP is unauthorized the app shows an「授權」button → /api/mcp/authorize → token stored in server/.mcp-token.json.
FUNRAISE_MCP_URL=https://connector.mcp.funraise.ai/t/hkvmS7xU5N5TnxXalyUUA/mcp
FUNRAISE_MCP_TOKEN=              # optional static bearer token (skips OAuth)
FUNRAISE_MCP_CLIENT_ID=          # optional pre-registered OAuth client (otherwise registered dynamically)
FUNRAISE_MCP_CLIENT_SECRET=

# Fish Audio TTS (voices for narration & answers). Free dev model works without API credit.
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
# JSON array of voices offered in the UI (id = Fish Audio model id). Default = Nelsen, Eunice (account voices) + 台灣腔女生版 (public).
FISH_VOICES=

# ---- LLM（對城市說話的大腦）：有 OPENAI_API_KEY 就用 OpenAI Responses API；沒有才用 ANTHROPIC_API_KEY。LLM_PROVIDER=openai|anthropic 可強制。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=

# ---- 快照優先資料層（Phase 9G，server/snapshot.mjs + server/cache.mjs）：多數問題先查本地 public/data/peaklens.json
# （＋ timeseries.json，若已產生）回答，省下大部分 FUNRAISE MCP 呼叫與 token。
# PEAKLENS_DATA_DIR=     # 可選：覆蓋快照 json 所在目錄（測試用；預設 app/public/data）
# MCP_ALLOWED_TOOLS=            # 逗號分隔的 FUNRAISE MCP 工具白名單；預設 31 個睿鏡用得到的工具（每回合省約 2 萬 token）；填 all 關掉過濾
# MCP_CACHE_TTL_S=600    # query_snapshot 結果的記憶體 LRU 快取存活秒數（最多 200 筆）

# ---- 即時資料（server 代理，金鑰不進前端）
CWA_API_KEY=            # 中央氣象署 opendata.cwa.gov.tw 授權碼 → 天氣角標
MOENV_AQI_API_KEY=      # 環境部 data.moenv.gov.tw → AQI 角標
TDX_CLIENT_ID=          # 交通部 TDX → 捷運真實站間時間、公車／YouBike
TDX_CLIENT_SECRET=
ORS_API_KEY=            # OpenRouteService → 真實路網步行／開車等時圈
MAPILLARY_ACCESS_TOKEN= # 可選：建物街景縮圖
CARTO_API_KEY=          # 可選：CARTO 底圖長期穩定
# PEAKLENS_DEMO_LIVE=1  # 測試用擬真資料：上面四把 key 缺席時，/api/env、/api/youbike、/api/tdx/s2s、
                        # /api/walkshed 改回傳標記 demo:true 的擬真讀數，不再是 null／503（見 §16.8）；
                        # 有真金鑰的項目一律照舊打真上游，這個旗標不會蓋掉任何一把已經生效的金鑰。

# ---- 前端金鑰（build 時帶入；Pages 版放 repo Secrets）
VITE_CESIUM_ION_TOKEN=  # Cesium World Terrain（畫質面板「地形」）
